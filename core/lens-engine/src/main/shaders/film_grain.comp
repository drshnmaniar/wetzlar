#version 320 es
precision highp float;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly uniform highp image2D uInputImage;
layout(binding = 1, rgba16f) writeonly uniform highp image2D uOutputImage;

uniform float uGrainStrength; // 0.0 to 1.0
uniform float uSeed;          // Random frame seed

// High quality pseudo-random hash generator
float hash(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputImage);

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec4 color = imageLoad(uInputImage, coord);

    if (uGrainStrength <= 0.001) {
        imageStore(uOutputImage, coord, color);
        return;
    }

    // Silver-halide grain distribution (denser in midtones, less in extreme blacks/whites)
    float luma = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    float midtoneWeight = 1.0 - abs(luma - 0.5) * 2.0;
    midtoneWeight = clamp(midtoneWeight, 0.2, 1.0);

    vec2 uv = vec2(coord) + vec2(uSeed * 17.13, uSeed * 43.19);
    float noise = (hash(uv) - 0.5) * 2.0;

    vec3 grained = color.rgb + (noise * uGrainStrength * 0.12 * midtoneWeight);
    imageStore(uOutputImage, coord, vec4(clamp(grained, 0.0, 1.0), color.a));
}
