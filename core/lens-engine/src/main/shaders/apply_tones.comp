#version 320 es
precision highp float;
precision highp sampler3D;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) readonly uniform highp image2D uInputImage;
layout(binding = 1, rgba16f) writeonly uniform highp image2D uOutputImage;
layout(binding = 2) uniform sampler3D uLutTexture;

uniform float uIntensity;       // 0.0 to 1.0 Look intensity
uniform vec3 uColorFilter;      // RGB weight for Monochrome filters
uniform bool uIsMonochrome;     // Monochrome flag

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputImage);

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec4 color = imageLoad(uInputImage, coord);
    vec3 rgb = clamp(color.rgb, 0.0, 1.0);

    // Apply monochrome glass filter weight if applicable
    if (uIsMonochrome) {
        rgb = rgb * uColorFilter;
        float gray = dot(rgb, vec3(0.299, 0.587, 0.114));
        rgb = vec3(gray);
    }

    // 3D LUT sampling (64x64x64 texture coordinates with half-texel offset)
    vec3 lutCoord = (rgb * 63.0 + 0.5) / 64.0;
    vec3 graded = texture(uLutTexture, lutCoord).rgb;

    // Mix between base and graded color by intensity
    vec3 finalRgb = mix(color.rgb, graded, uIntensity);

    imageStore(uOutputImage, coord, vec4(finalRgb, color.a));
}
